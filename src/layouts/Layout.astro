---
import '../styles/fonts.css';
import '../styles/variables.css';
import '../styles/responsive.css';
import '../styles/navbar.css';
import Navbar from '../components/Navbar.astro';

// Terceros auto-hospedados desde public/. Antes venian de jsdelivr, lo que
// anadia un salto DNS+TLS bloqueante y dejaba el CSS del sitio a merced de que
// el CDN estuviera en pie.
const base = import.meta.env.BASE_URL;

interface Props {
	title: string;
    description?: string;
    useSwiper?: boolean;
    noindex?: boolean;
}

const { title, description = "DesvoSoft: Aprende Git, Python y más en este sitio sobre herramientas del nuevo mundo digital.", useSwiper = false, noindex = false } = Astro.props;
const pageTitle = `${title} · DesvoSoft`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL('/HelloWorld/images/gallery/1.webp', Astro.site);
---

<!doctype html>
<html lang="es" data-theme="dark">
	<head>
		<meta charset="UTF-8" />
        <meta name="google-site-verification" content="t61vFNx51RZSU9UsbAIbH6cTzFvAJKXvFHbvUo0UAH0" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width, initial-scale=1" />

		<title>{pageTitle}</title>
        <link rel="canonical" href={canonicalURL} />
        {/* favicon.svg era el logo por defecto de Astro, nunca personalizado, y
            tampoco se declaraba: el navegador caia al /favicon.ico implicito de
            la raiz del dominio (fuera de /HelloWorld/) y se llevaba un 404 en
            cada pagina. La esfera de nieve ya existia en public/images/theme.ico
            sin usar, y coincide con la ilustracion del hero (montana + luna). */}
        <link rel="icon" type="image/x-icon" href={`${base}favicon.ico`} />
        {noindex && <meta name="robots" content="noindex, nofollow" />}

        <meta property="og:type" content="website" />
        <meta property="og:title" content={pageTitle} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonicalURL} />
        <meta property="og:image" content={ogImageURL} />
        <meta property="og:locale" content="es_ES" />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={pageTitle} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={ogImageURL} />

        <link rel="preload" as="font" type="font/woff2" href={`${base}fonts/roboto-400-latin.woff2`} crossorigin />
        <link rel="preload" as="font" type="font/woff2" href={`${base}fonts/fira-code-400-latin.woff2`} crossorigin />

        <script type="application/ld+json" set:html={JSON.stringify({
            "@context": "https://schema.org",
            "@type": "WebSite",
            "name": "DesvoSoft",
            "description": "DesvoSoft: Aprende Git, Python y más en este sitio sobre herramientas del nuevo mundo digital.",
            "url": "https://desvosoft.github.io/HelloWorld/",
            "publisher": {
                "@type": "Organization",
                "name": "DesvoSoft",
                "url": "https://github.com/DesvoSoft"
            }
        })} />

        <link rel="stylesheet" href={`${base}vendor/vitra/vitra.min.css`} />
        <script src={`${base}vendor/vitra/vitra.min.js`} is:inline defer></script>
        {useSwiper && <link rel="stylesheet" href={`${base}vendor/swiper/swiper-bundle.min.css`} />}

        <slot name="head" />
	</head>
	<body>
        <div class="mesh-bg" aria-hidden="true"></div>

        <header>
            <slot name="header" />
        </header>

        <Navbar />

		<slot />

        <footer class="site-footer">
            <div class="footer-inner vitra-glass">
                <div class="footer-top">
                    <div class="footer-brand">
                        <span class="code-line-logo">Hello World</span>
                        <p class="footer-tagline">&copy; <span id="footer-year">2025</span> DesvoSoft · Hecho con <a href="https://github.com/DesvoSoft/Vitra" target="_blank" rel="noopener">Vitra CSS</a> + <a href="https://astro.build" target="_blank" rel="noopener">Astro</a></p>
                    </div>

                    <div class="footer-socials">
                        <a href="https://github.com/DesvoSoft/HelloWorld" target="_blank" rel="noopener" aria-label="GitHub" title="GitHub">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                                <path d="M12 .5C5.73.5.98 5.24.98 11.5c0 5.02 3.26 9.28 7.77 10.78.57.1.78-.25.78-.55l-.01-2.14c-3.16.69-3.83-1.36-3.83-1.36-.52-1.31-1.26-1.66-1.26-1.66-1.03-.7.08-.69.08-.69 1.14.08 1.74 1.17 1.74 1.17 1.01 1.73 2.65 1.23 3.3.94.1-.73.4-1.23.72-1.51-2.52-.29-5.17-1.26-5.17-5.6 0-1.24.44-2.25 1.17-3.05-.12-.29-.51-1.46.11-3.04 0 0 .96-.31 3.15 1.16a10.9 10.9 0 0 1 5.73 0c2.18-1.47 3.14-1.16 3.14-1.16.63 1.58.23 2.75.12 3.04.73.8 1.17 1.81 1.17 3.05 0 4.35-2.65 5.31-5.18 5.59.41.36.77 1.06.77 2.14l-.01 3.17c0 .31.2.66.79.55A11.5 11.5 0 0 0 23.02 11.5C23.02 5.24 18.27.5 12 .5Z"/>
                            </svg>
                        </a>
                        <a href="https://discord.gg/NUd5HsuYX" target="_blank" rel="noopener" aria-label="Discord" title="Discord">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                                <path d="M20.317 4.3698a19.7913 19.7913 0 0 0-4.8851-1.5152.0741.0741 0 0 0-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.68-.2762-5.4868 0-.1636-.3933-.4058-.8742-.6177-1.2495a.077.077 0 0 0-.0785-.037 19.7363 19.7363 0 0 0-4.8852 1.515.0699.0699 0 0 0-.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0824.0824 0 0 0 .0312.0561c2.0528 1.5076 4.0413 2.4228 5.9929 3.0294a.0777.0777 0 0 0 .0842-.0276c.4616-.6304.8731-1.2952 1.226-1.9942a.076.076 0 0 0-.0416-.1057 13.0129 13.0129 0 0 1-1.8722-.8923.077.077 0 0 1-.0076-.1277c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 0 1 .0776-.0105c3.9278 1.7933 8.18 1.7933 12.0614 0a.0739.0739 0 0 1 .0785.0095c.1202.099.246.1981.3728.2924a.077.077 0 0 1-.0066.1276 12.2986 12.2986 0 0 1-1.873.8914.0766.0766 0 0 0-.0407.1067c.3604.698.7719 1.3628 1.225 1.9932a.076.076 0 0 0 .0842.0286c1.961-.6067 3.9495-1.5219 6.0023-3.0294a.077.077 0 0 0 .0313-.0552c.5004-5.177-.8382-9.6739-3.5485-13.6604a.061.061 0 0 0-.0312-.0286ZM8.02 15.3312c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9555-2.4189 2.157-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.9555 2.4189-2.1569 2.4189Zm7.9748 0c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9554-2.4189 2.1569-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.946 2.4189-2.1568 2.4189Z"/>
                            </svg>
                        </a>
                        <a href="https://www.youtube.com/@desvosoft" target="_blank" rel="noopener" aria-label="YouTube" title="YouTube">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                                <path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.6 3.5 12 3.5 12 3.5s-7.6 0-9.4.6A3 3 0 0 0 .5 6.2 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.8.6 9.4.6 9.4.6s7.6 0 9.4-.6a3 3 0 0 0 2.1-2.1A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.8ZM9.6 15.6V8.4l6.3 3.6-6.3 3.6Z"/>
                            </svg>
                        </a>
                        <a href="mailto:desvox23@gmail.com" aria-label="Email" title="desvox23@gmail.com">
                            <span class="footer-email-icon">@</span>
                        </a>
                    </div>
                </div>
            </div>
        </footer>

        {useSwiper && <script src={`${base}vendor/swiper/swiper-bundle.min.js`} is:inline defer></script>}
        <script is:inline>
            const footerYear = document.getElementById('footer-year');
            if (footerYear) footerYear.textContent = new Date().getFullYear();
        </script>
	</body>
</html>

<style>
    body {
        position: relative;
    }

    .site-footer {
        padding: var(--vitra-space-4, 2rem) var(--vitra-space-4, 2rem) var(--vitra-space-3, 1.5rem);
        margin-top: var(--vitra-space-8, 4rem);
        color: var(--vitra-color-text-secondary, #ffffffb3);
        font-size: 0.9rem;
    }

    /* Una sola fila: marca+créditos a la izquierda, redes a la derecha. Antes
       el copyright vivía en una segunda fila bajo una regla y se leía como un
       segundo footer; ahora el año y los créditos son la propia bajada de marca. */
    .footer-inner {
        max-width: var(--content-max-width, 1100px);
        margin: 0 auto;
        padding: var(--vitra-space-4, 2rem) var(--vitra-space-5, 2.5rem);
        border-radius: 16px;
        display: flex;
        flex-direction: column;
        gap: var(--vitra-space-3, 1.5rem);
    }

    .footer-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--vitra-space-4, 2rem);
    }

    .footer-brand {
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
    }

    .footer-brand .code-line-logo {
        padding-left: 1em;
        font-size: 1.1rem;
        font-weight: 600;
    }

    .footer-tagline {
        margin: 0;
        max-width: 380px;
        line-height: 1.6;
        font-size: 0.85rem;
        color: var(--vitra-color-text-secondary, #ffffffb3);
    }

    .footer-tagline a {
        color: inherit;
        text-decoration: underline;
        text-underline-offset: 2px;
    }

    .footer-tagline a:hover {
        color: var(--vitra-color-text-strong, #fff);
    }

    .footer-socials {
        display: flex;
        align-items: center;
        gap: var(--vitra-space-3, 1.5rem);
        flex-shrink: 0;
    }

    .footer-socials a {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 44px;
        height: 44px;
        border-radius: 50%;
        color: var(--vitra-color-text-secondary, #ffffffb3);
        transition: color 0.2s ease, background 0.2s ease, transform 0.2s ease;
    }

    .footer-socials a img,
    .footer-socials a svg {
        display: block;
        opacity: 0.75;
        transition: opacity 0.2s ease;
    }

    .footer-socials a:hover {
        background: var(--accent-soft, hsl(var(--vitra-color-accent-h) 80% 60% / 18%));
        transform: translateY(-2px);
    }

    .footer-socials a:hover img,
    .footer-socials a:hover svg {
        opacity: 1;
    }

    .footer-email-icon {
        font-size: 1.1rem;
        font-weight: 600;
    }

    @media (max-width: 640px) {
        .footer-top {
            flex-direction: column;
            align-items: flex-start;
            gap: var(--vitra-space-3, 1.5rem);
        }

        /* Las redes ya no compiten con la marca por el ancho: se alinean al
           borde izquierdo y el área táctil de 44px se compensa hacia fuera
           para que los iconos sigan a ras del texto de arriba. */
        .footer-socials {
            margin-left: -10px;
            gap: var(--vitra-space-1, 0.5rem);
        }
    }
</style>
