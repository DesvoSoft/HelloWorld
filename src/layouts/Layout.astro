---
import '../styles/variables.css';
import '../styles/responsive.css';
import '../styles/navbar.css';
import Navbar from '../components/Navbar.astro';

interface Props {
	title: string;
    description?: string;
    useSwiper?: boolean;
    noindex?: boolean;
}

const { title, description = "DesvoSoft: Aprende Git, Python y más en este sitio sobre herramientas del nuevo mundo digital.", useSwiper = false, noindex = false } = Astro.props;
const pageTitle = `${title} · DesvoSoft`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL('/HelloWorld/images/gallery/1.webp', Astro.site);
---

<!doctype html>
<html lang="es" data-theme="dark">
	<head>
		<meta charset="UTF-8" />
        <meta name="google-site-verification" content="t61vFNx51RZSU9UsbAIbH6cTzFvAJKXvFHbvUo0UAH0" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width, initial-scale=1" />

		<title>{pageTitle}</title>
        <link rel="canonical" href={canonicalURL} />
        {noindex && <meta name="robots" content="noindex, nofollow" />}

        <meta property="og:type" content="website" />
        <meta property="og:title" content={pageTitle} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonicalURL} />
        <meta property="og:image" content={ogImageURL} />
        <meta property="og:locale" content="es_ES" />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={pageTitle} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={ogImageURL} />

        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500;600&family=Roboto:wght@400;500;700&display=swap" rel="stylesheet" />
        <link rel="preconnect" href="https://cdn.jsdelivr.net" />

        <script type="application/ld+json" set:html={JSON.stringify({
            "@context": "https://schema.org",
            "@type": "WebSite",
            "name": "DesvoSoft",
            "description": "DesvoSoft: Aprende Git, Python y más en este sitio sobre herramientas del nuevo mundo digital.",
            "url": "https://desvosoft.github.io/HelloWorld/",
            "publisher": {
                "@type": "Organization",
                "name": "DesvoSoft",
                "url": "https://github.com/DesvoSoft"
            }
        })} />

        <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/DesvoSoft/Vitra@v1.12.1/dist/vitra.min.css" integrity="sha256-aKZPxSYkeZQfenXrPana9MGvzOFE0eCsdPLpzU+EBE4=" crossorigin="anonymous">
        <script src="https://cdn.jsdelivr.net/gh/DesvoSoft/Vitra@v1.12.1/dist/vitra.min.js" integrity="sha256-8cQKCN/ypSOrZmry8+eH2w3dgVQiaNqB92DHS2aqI/s=" crossorigin="anonymous" defer></script>
        {useSwiper && <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css"/>}

        <slot name="head" />
	</head>
	<body>
        <div class="mesh-bg" aria-hidden="true">
            <div class="mesh-blob mesh-blob-1"></div>
            <div class="mesh-blob mesh-blob-2"></div>
            <div class="mesh-blob mesh-blob-3"></div>
            <div class="mesh-blob mesh-blob-4"></div>
        </div>

        <header>
            <slot name="header" />
        </header>

        <Navbar />

		<slot />

        <footer class="site-footer">
            <div class="footer-inner vitra-glass">
                <div class="footer-brand">
                    <span class="code-line-logo">Hello World</span>
                    <p class="footer-tagline">Aprende Git, Python y más en este sitio sobre herramientas del nuevo mundo digital.</p>
                </div>

                <div class="footer-socials">
                    <a href="https://github.com/DesvoSoft/HelloWorld" target="_blank" rel="noopener" aria-label="GitHub" title="GitHub">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                            <path d="M12 .5C5.73.5.98 5.24.98 11.5c0 5.02 3.26 9.28 7.77 10.78.57.1.78-.25.78-.55l-.01-2.14c-3.16.69-3.83-1.36-3.83-1.36-.52-1.31-1.26-1.66-1.26-1.66-1.03-.7.08-.69.08-.69 1.14.08 1.74 1.17 1.74 1.17 1.01 1.73 2.65 1.23 3.3.94.1-.73.4-1.23.72-1.51-2.52-.29-5.17-1.26-5.17-5.6 0-1.24.44-2.25 1.17-3.05-.12-.29-.51-1.46.11-3.04 0 0 .96-.31 3.15 1.16a10.9 10.9 0 0 1 5.73 0c2.18-1.47 3.14-1.16 3.14-1.16.63 1.58.23 2.75.12 3.04.73.8 1.17 1.81 1.17 3.05 0 4.35-2.65 5.31-5.18 5.59.41.36.77 1.06.77 2.14l-.01 3.17c0 .31.2.66.79.55A11.5 11.5 0 0 0 23.02 11.5C23.02 5.24 18.27.5 12 .5Z"/>
                        </svg>
                    </a>
                    <a href="https://discord.gg/aCaHssJJu" target="_blank" rel="noopener" aria-label="Discord" title="Discord">
                        <img src="https://www.tradingdigits.io/assets/images/discordLogo.png" alt="" width="20">
                    </a>
                    <a href="https://www.youtube.com/@desvosoft" target="_blank" rel="noopener" aria-label="YouTube" title="YouTube">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                            <path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.6 3.5 12 3.5 12 3.5s-7.6 0-9.4.6A3 3 0 0 0 .5 6.2 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.8.6 9.4.6 9.4.6s7.6 0 9.4-.6a3 3 0 0 0 2.1-2.1A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.8ZM9.6 15.6V8.4l6.3 3.6-6.3 3.6Z"/>
                        </svg>
                    </a>
                    <a href="https://x.com/DesvoSoft" target="_blank" rel="noopener" aria-label="X" title="X">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                            <path d="M18.9 2h3.3l-7.2 8.2L23.5 22h-6.6l-5.2-6.8L5.7 22H2.4l7.7-8.8L1.5 2h6.8l4.7 6.2L18.9 2Zm-1.2 18h1.8L7.4 4h-1.9l12.2 16Z"/>
                        </svg>
                    </a>
                    <a href="mailto:desvox23@gmail.com" aria-label="Email" title="desvox23@gmail.com">
                        <span class="footer-email-icon">@</span>
                    </a>
                </div>
            </div>

            <p class="footer-copyright" data-i18n="footerCopyright">&copy; <span id="footer-year">2025</span> DesvoSoft</p>
            <p class="footer-credits">Hecho con <a href="https://github.com/DesvoSoft/Vitra" target="_blank" rel="noopener">Vitra CSS</a> + <a href="https://astro.build" target="_blank" rel="noopener">Astro</a></p>
        </footer>

        {useSwiper && <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js" is:inline defer></script>}
        <script is:inline>
            const footerYear = document.getElementById('footer-year');
            if (footerYear) footerYear.textContent = new Date().getFullYear();
        </script>
	</body>
</html>

<style>
    body {
        position: relative;
    }

    .site-footer {
        padding: var(--vitra-space-4, 2rem) var(--vitra-space-4, 2rem) var(--vitra-space-3, 1.5rem);
        margin-top: var(--vitra-space-8, 4rem);
        color: var(--vitra-color-text-secondary, #ffffffb3);
        font-size: 0.9rem;
    }

    .footer-inner {
        max-width: var(--content-max-width, 1100px);
        margin: 0 auto;
        padding: var(--vitra-space-4, 2rem) var(--vitra-space-5, 2.5rem);
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--vitra-space-4, 2rem);
    }

    .footer-brand {
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
    }

    .footer-brand .code-line-logo {
        padding-left: 1em;
        font-size: 1.1rem;
        font-weight: 600;
    }

    .footer-tagline {
        margin: 0;
        max-width: 380px;
        line-height: 1.6;
        font-size: 0.85rem;
        color: var(--vitra-color-text-secondary, #ffffffb3);
    }

    .footer-socials {
        display: flex;
        align-items: center;
        gap: var(--vitra-space-3, 1.5rem);
        flex-shrink: 0;
    }

    .footer-socials a {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        border-radius: 50%;
        color: var(--vitra-color-text-secondary, #ffffffb3);
        transition: color 0.2s ease, background 0.2s ease, transform 0.2s ease;
    }

    .footer-socials a img,
    .footer-socials a svg {
        display: block;
        opacity: 0.75;
        transition: opacity 0.2s ease;
    }

    .footer-socials a:hover {
        background: var(--accent-soft, hsl(var(--vitra-color-accent-h) 80% 60% / 18%));
        transform: translateY(-2px);
    }

    .footer-socials a:hover img,
    .footer-socials a:hover svg {
        opacity: 1;
    }

    .footer-email-icon {
        font-size: 1.1rem;
        font-weight: 600;
    }

    .footer-copyright {
        text-align: center;
        margin: var(--vitra-space-3, 1.5rem) 0 0;
        font-size: 0.8rem;
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 0.3rem;
    }

    .footer-credits {
        text-align: center;
        margin: 0.35rem 0 0;
        font-size: 0.75rem;
        color: var(--vitra-color-text-secondary, #ffffffb3);
    }

    .footer-credits a {
        color: inherit;
        text-decoration: underline;
        text-underline-offset: 2px;
    }

    .footer-credits a:hover {
        color: var(--vitra-color-text-strong, #fff);
    }

    @media (max-width: 640px) {
        .footer-inner {
            flex-direction: column;
            align-items: flex-start;
            gap: var(--vitra-space-3, 1.5rem);
        }
    }
</style>
