---
import Layout from '../layouts/Layout.astro';
import CoinTracker from '../components/CoinTracker.astro';
import '../styles/page-specific/info-pages.css';
import '../styles/page-specific/crypto.css';
import '../styles/crypto-toc.css';
---

<Layout title="Guía de Criptomonedas">
    <style>
      .doc-section {
        scroll-margin-top: calc(var(--navbar-h, 64px) + 76px);
      }

      @media (max-width: 900px) {
        .doc-section {
          scroll-margin-top: 230px;
        }
      }

      hr.section-sep {
        border: 0;
        height: 1px;
        background: linear-gradient(90deg, transparent, var(--vitra-color-border, rgba(255, 255, 255, 0.08)), transparent);
        margin: 2.5rem auto;
        width: min(760px, 80%);
        opacity: 0.5;
        border-radius: 1px;
      }

      .content-shell {
        width: auto !important; /* !important corrige el ancho inline heredado del layout original */
        max-width: var(--content-max-width, 1100px);
        margin: 0 auto;
        padding: 0 1.5rem;
      }

      .tracker-grid {
        display: flex;
        flex-wrap: wrap;
        gap: 1.5rem;
        justify-content: center;
        margin: 1.5rem 0;
      }

      .tracker-grid > * {
        flex: 1 1 340px;
      }

      @media (max-width: 480px) {
        .content-shell {
          padding: 0 1rem;
        }

        .tracker-grid {
          gap: 1.25rem;
          margin: 1.25rem 0;
        }
      }

      /* Pop-up */
      .popup-overlay {
        display: none;
        position: fixed;
        inset: 0;
        z-index: 1000;
        justify-content: center;
        align-items: center;
        background-color: rgba(0, 0, 0, 0.55);
        backdrop-filter: blur(5px);
      }

      .popup-content {
        padding: 2rem;
        max-width: 500px;
        width: 90%;
        position: relative;
        animation: popupFadeIn 0.3s ease-out;
      }

      @keyframes popupFadeIn {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
      }

      .popup-close-btn {
        position: absolute;
        top: 1rem;
        right: 1rem;
        background: none;
        border: none;
        color: var(--vitra-color-text-muted, #8892b0);
        font-size: 1.5rem;
        cursor: pointer;
        padding: 0.25rem;
        line-height: 1;
        transition: color 0.2s;
      }

      .popup-close-btn:hover {
        color: var(--vitra-color-text-strong, #fff);
      }

      .popup-header {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-bottom: 1.5rem;
        border-bottom: 1px solid var(--vitra-color-border, rgba(255, 255, 255, 0.1));
        padding-bottom: 1rem;
      }

      .popup-icon {
        font-size: 1.5rem;
      }

      .popup-header h2 {
        margin: 0;
        font-size: 1.5rem;
        color: var(--vitra-color-text-strong, #fff);
        border: none;
        padding: 0;
      }

      .popup-body {
        color: var(--vitra-color-text, #a8b2d1);
        font-size: 0.95rem;
        line-height: 1.6;
        margin-bottom: 2rem;
      }

      .popup-body p {
        margin-bottom: 1rem;
      }

      .popup-body p:last-child {
        margin-bottom: 0;
      }

      .popup-actions {
        display: flex;
        justify-content: flex-end;
      }

      .popup-accept-btn {
        background: var(--vitra-color-accent, #64ffda);
        color: var(--vitra-color-on-accent, #0a192f);
        border: none;
        padding: 0.75rem 1.5rem;
        border-radius: 12px;
        font-weight: 600;
        cursor: pointer;
        transition: transform 0.2s, filter 0.2s;
      }

      .popup-accept-btn:hover {
        transform: translateY(-2px);
        filter: brightness(1.1);
      }

      .disclaimer-btn {
        display: flex;
        justify-content: center;
        margin: 2rem 0;
      }

      .show-popup-btn {
        color: var(--vitra-color-accent, #64ffda);
        padding: 0.75rem 1.5rem;
        border-radius: 12px;
        font-weight: 600;
        cursor: pointer;
        transition: transform 0.3s ease;
        letter-spacing: 0.02em;
      }

      .show-popup-btn:hover {
        transform: translateY(-2px);
      }
    </style>
    
