---
import Layout from '../layouts/Layout.astro';
// JetBrains Mono para el texto que se teclea: distingue l/1/I y 0/O sin
// ambigüedad, que es justo lo que no se puede sacrificar en un test de
// precisión. VT323 solo para el cromo del chasis y los marcadores.
import '../styles/fonts-raptor.css';
import '../styles/page-specific/info-pages.css';
import '../styles/page-specific/raptor.css';

const base = import.meta.env.BASE_URL;
---

<Layout title="Raptor - Typing Test" description="Raptor: prueba de velocidad de escritura estilo Monkeytype.">

    {/* Ver raptor-historial: sin precarga, el swap de estas dos fuentes reflowa
        el chasis despues del primer pintado. Aqui pesa mas todavia, porque el
        texto que se teclea esta en JetBrains Mono. */}
    <Fragment slot="head">
        <link rel="preload" as="font" type="font/woff2" href={`${base}fonts/vt323-400-latin.woff2`} crossorigin />
        <link rel="preload" as="font" type="font/woff2" href={`${base}fonts/jetbrains-mono-400-latin.woff2`} crossorigin />
    </Fragment>

    <main class="doc-section raptor-section">
        <!-- Chasis CRT. Las capas decorativas (scanlines, brillo) son hermanas del
             contenido y no lo envuelven, para que ningún filtro caiga sobre el
             texto que hay que leer con precisión. -->
        <div id="raptorCrt" class="raptor-crt">
            <div class="raptor-screen">
                <div class="raptor-scanlines" aria-hidden="true"></div>
                <div class="raptor-glare" aria-hidden="true"></div>

                <div class="raptor-screen-inner">
                    <header class="raptor-tty">
                        <h1 class="tty-title">RAPTOR</h1>
                        <span class="tty-rule" aria-hidden="true"></span>
                        <span class="tty-meta">tty0</span>
                        <a class="tty-btn" href="/HelloWorld/raptor-historial/">historial</a>
                        <button id="crtToggleBtn" class="tty-btn" type="button" aria-pressed="true">CRT</button>
                        <button id="soundToggleBtn" class="tty-btn" type="button" aria-pressed="true" title="Silenciar sonido">🔊</button>
                    </header>

                    <p class="raptor-boot">
                        <span class="boot-sigil" aria-hidden="true">&gt;</span>
                        velocidad de escritura con feedback en vivo y práctica dirigida a tus errores
                    </p>

                    <div id="controls" class="raptor-controls">
                        <label class="raptor-field" for="durationSelect">
                            <span class="raptor-field-label">test</span>
                            <!-- Un solo control para las dos familias: `t` son
                                 segundos, `w` son palabras. -->
                            <select id="durationSelect">
                                <optgroup label="tiempo">
                                    <option value="t15">15 s</option>
                                    <option value="t30" selected>30 s</option>
                                    <option value="t60">60 s</option>
                                    <option value="t120">120 s</option>
                                </optgroup>
                                <optgroup label="palabras">
                                    <option value="w10">10 palabras</option>
                                    <option value="w25">25 palabras</option>
                                    <option value="w50">50 palabras</option>
                                    <option value="w100">100 palabras</option>
                                </optgroup>
                            </select>
                        </label>

                        <label class="raptor-field" for="modeSelect">
                            <span class="raptor-field-label">modo</span>
                            <select id="modeSelect">
                                <option value="random">random</option>
                                <option value="terry">terry davis</option>
                                <option value="prompts">prompts ia</option>
                                <option value="practice">mis errores</option>
                            </select>
                        </label>

                        <label class="raptor-toggle" for="punctToggle">
                            <input type="checkbox" id="punctToggle" />
                            <span>puntuación</span>
                        </label>

                        <label class="raptor-toggle" for="numbersToggle">
                            <input type="checkbox" id="numbersToggle" />
                            <span>números</span>
                        </label>

                        <button id="newGameBtn" type="button">reiniciar</button>
                    </div>

                    <p id="practiceHint" class="raptor-hint" hidden></p>

                    <div id="info" class="raptor-stats" aria-live="off">
                        <span class="stat"><span class="stat-label" id="statTimeLabel">Tiempo</span><span id="statTime" class="stat-value">30</span></span>
                        <span class="stat"><span class="stat-label">WPM neto</span><span id="statWpm" class="stat-value">0</span></span>
                        <span class="stat"><span class="stat-label">Precisión</span><span id="statAcc" class="stat-value">100%</span></span>
                    </div>

                    <p id="capsWarning" class="raptor-caps-warning" hidden>⚠ Bloq Mayús activado</p>

                    <div id="typingArea" class="raptor-typing-area">
                        <input
                            id="raptorInput"
                            class="raptor-input"
                            type="text"
                            autocomplete="off"
                            autocorrect="off"
                            autocapitalize="off"
                            spellcheck="false"
                            aria-label="Área de escritura del test"
                        />
                        <div class="words-viewport">
                            <div id="words" class="words-inner"></div>
                        </div>
                        <div id="focusOverlay" class="raptor-focus-overlay" hidden>
                            <span>Haz clic o pulsa una tecla para continuar</span>
                        </div>
                    </div>

                    <p class="raptor-shortcut-hint">
                        <kbd>Tab</kbd> reiniciar · <kbd>Ctrl</kbd>+<kbd>&#9003;</kbd> borrar palabra
                    </p>

                    <div id="result" role="status" aria-live="polite"></div>
                </div>
            </div>

            <p class="raptor-bezel-label" aria-hidden="true">DESVOSOFT · MODEL R-1</p>
        </div>
    </main>

    <!-- El mapa de teclado se carga antes que el motor porque este solo lo usa
         al terminar una partida, y así la página del historial puede reutilizar
         el mismo fichero sin arrastrar el motor entero. -->
    <script>
        import "../scripts/raptor-keyboard.js";
        import "../scripts/raptor.js";
    </script>
</Layout>
