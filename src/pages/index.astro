---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import '../styles/page-specific/home.css';
import '../styles/page-specific/info-pages.css';
import gallery1 from '../assets/gallery/1.webp';
import gallery2 from '../assets/gallery/2.webp';
import gallery3 from '../assets/gallery/3.webp';
import gallery4 from '../assets/gallery/4.webp';
import gallery5 from '../assets/gallery/5.webp';
import gallery6 from '../assets/gallery/6.webp';
import gallery7 from '../assets/gallery/7.webp';
import gallery8 from '../assets/gallery/8.webp';
import gallery9 from '../assets/gallery/9.webp';
import gallery10 from '../assets/gallery/10.webp';

const galleryImages = [gallery1, gallery2, gallery3, gallery4, gallery5, gallery6, gallery7, gallery8, gallery9, gallery10];
---

<Layout title="Hello World" useSwiper={true}>
    <div class="vitra-container home-container">
        <section id="home" class="vitra-scenery-inline">
            <div class="vitra-scenery-sky" aria-hidden="true"></div>
            <div class="vitra-scenery-clouds" aria-hidden="true"></div>
            <div class="vitra-scenery-stars" aria-hidden="true"></div>
            <div class="vitra-scenery-halo" aria-hidden="true"></div>
            <div class="vitra-scenery-ridge-far" aria-hidden="true"></div>
            <div class="vitra-scenery-ridge-mid" aria-hidden="true"></div>
            <div class="vitra-scenery-ridge-near" aria-hidden="true"></div>
            <div class="vitra-scenery-grain" aria-hidden="true"></div>
            <div class="hero-inner">
                <p class="hero-kicker">Desarrollador &amp; eterno aprendiz</p>
                <h1 class="vitra-gradient-text">Hola Mundo</h1>
                <p class="hero-lead">
                    Bienvenido a Hello World: un espacio para compartir fundamentos de programación y explorar la evolución digital.
                </p>
                <p class="hero-sub">
                    Nació como práctica de Git y GitHub, y hoy crece con contenido conciso y práctico para quienes están comenzando o quieren reforzar lo básico.
                </p>
            </div>
        </section>

        <section class="reveal-left content-section">
            <div class="section-inner about-card">
                <h2>Acerca</h2>

                <p>
                    Este sitio es mi espacio para experimentar y compartir al mismo tiempo, lo que ves aquí es un reflejo de mi evolución como eterno aprendiz.
                </p>

                <p>
                    Me interesa explorar temas como el diseño web, el desarrollo de videojuegos y el uso de nuevas tecnologías. Cada proyecto es una oportunidad para aprender algo nuevo, y me encantaría que este sitio también sea útil para ti.
                    Puedes encontrar el código del sitio en:
                </p>

                <a href="https://github.com/DesvoSoft/HelloWorld" class="vitra-btn vitra-btn-glass github-link" target="_blank" rel="noopener">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <path d="M12 .5C5.73.5.98 5.24.98 11.5c0 5.02 3.26 9.28 7.77 10.78.57.1.78-.25.78-.55l-.01-2.14c-3.16.69-3.83-1.36-3.83-1.36-.52-1.31-1.26-1.66-1.26-1.66-1.03-.7.08-.69.08-.69 1.14.08 1.74 1.17 1.74 1.17 1.01 1.73 2.65 1.23 3.3.94.1-.73.4-1.23.72-1.51-2.52-.29-5.17-1.26-5.17-5.6 0-1.24.44-2.25 1.17-3.05-.12-.29-.51-1.46.11-3.04 0 0 .96-.31 3.15 1.16a10.9 10.9 0 0 1 5.73 0c2.18-1.47 3.14-1.16 3.14-1.16.63 1.58.23 2.75.12 3.04.73.8 1.17 1.81 1.17 3.05 0 4.35-2.65 5.31-5.18 5.59.41.36.77 1.06.77 2.14l-.01 3.17c0 .31.2.66.79.55A11.5 11.5 0 0 0 23.02 11.5C23.02 5.24 18.27.5 12 .5Z"/>
                    </svg>
                    <span>GitHub</span>
                </a>
            </div>
        </section>

        <section id="projects" class="reveal content-section">
            <div class="section-inner projects-inner">
                <h2>Proyectos principales</h2>
                <div class="project-grid">
                    <a href="https://desvosoft.github.io/ZeroBlockBridge/" target="_blank" rel="noopener" class="project-card vitra-glass">
                        <div class="project-card-head">
                            <h3>ZeroBlockBridge</h3>
                            <span class="project-lang"><span class="project-lang-dot" data-lang="python"></span>Python</span>
                        </div>
                        <p class="project-desc">
                            App de escritorio que convierte cualquier PC en un servidor de Minecraft sin configuración técnica: túnel integrado con Playit.gg (sin abrir puertos ni tocar el router), auto-sanación con reinicio ante caídas, backups programados con un clic y un navegador de mods conectado a Modrinth que instala y actualiza todo por ti.
                        </p>
                        <div class="project-meta">
                            <span>GNU AGPLv3</span>
                        </div>
                        <span class="project-cta">Visitar sitio <span class="project-cta-arrow">→</span></span>
                    </a>

                    <a href="https://desvosoft.github.io/Vitra/" target="_blank" rel="noopener" class="project-card vitra-glass">
                        <div class="project-card-head">
                            <h3>Vitra</h3>
                            <span class="project-lang"><span class="project-lang-dot" data-lang="css"></span>CSS</span>
                        </div>
                        <p class="project-desc">
                            Framework CSS propio pensado para glassmorphism y motion design: arquitectura en capas <code>@layer</code>, sistema de partículas, escenografías animadas y siete temas intercambiables (claro, oscuro, neón, océano...). Es, de hecho, el mismo framework que le da estilo a este sitio.
                        </p>
                        <div class="project-meta">
                            <span>ISC License</span>
                        </div>
                        <span class="project-cta">Visitar sitio <span class="project-cta-arrow">→</span></span>
                    </a>
                </div>
            </div>
        </section>

        <section id="images" class="reveal-scale content-section">
            <div class="section-inner gallery-card gallery-inner">
            <h2 data-i18n="seccionImagenesTitulo">Imagenes</h2>
            <p>Colección de imágenes generadas con Stable Diffusion 1.5 (2022).</p>
            <br>
            <div class="swiper mySwiper">
                <div class="swiper-wrapper">
                    {galleryImages.map((img, i) => (
                        <div class="swiper-slide">
                            <Image src={img} loading="lazy" alt={`Imagen generada con Stable Diffusion 1.5 - ${i + 1}`} />
                        </div>
                    ))}
                </div>
                <div class="swiper-pagination"></div>
                <div class="swiper-button-next"></div>
                <div class="swiper-button-prev"></div>
            </div>

            <div class="gallery-essay">
                <p class="essay-kicker">Reflexión · sobre estas imágenes</p>
                <h3>El año en que todavía se le notaban las costuras</h3>
                <p>
                    2022. Stable Diffusion 1.5 recién salía al mundo y bastaba mirar dos segundos
                    para saber que algo ahí no era del todo real: manos con seis dedos, rostros que
                    se derretían en los bordes, texto imposible garabateado en un letrero, una
                    simetría casi correcta pero nunca del todo. El ojo humano, sin entrenamiento
                    alguno, era un detector casi perfecto. La falla era la firma.
                </p>
                <p>
                    Esa facilidad para detectar no era mérito nuestro. Era la torpeza del modelo.
                    Cada nueva versión —SDXL, Midjourney v6, los difusores que vinieron después—
                    fue puliendo exactamente esas costuras: las manos se corrigieron, la luz empezó
                    a comportarse como luz real, la coherencia geométrica dejó de ser un lujo. Lo
                    que antes delataba a la máquina, hoy simplemente desapareció.
                </p>
                <p>
                    Ahí hay algo incómodo: nuestra capacidad de distinguir lo generado de lo
                    fotografiado nunca dependió de nuestra percepción, dependía de qué tan buena
                    fuera la máquina en engañarnos. A medida que ese campo avanza, el margen para
                    confiar en "se ve raro, seguro es IA" se va cerrando hasta cero. La imagen deja
                    de ser evidencia por sí sola.
                </p>
                <p>
                    Vale la pena recordar de dónde viene todo esto. La visión por computadora nació
                    con una ambición mucho más modesta: reconocer, clasificar, medir. Los primeros
                    sistemas de los años 60 y 70 aprendían a distinguir un borde de una sombra, una
                    letra de un garabato — visión como herramienta de análisis, nunca de creación.
                    Que esa misma disciplina termine produciendo imágenes con intención estética,
                    que un modelo entrenado para reconocer patrones acabe proponiendo composición,
                    color y atmósfera, es un giro que sus fundadores difícilmente imaginaron. La
                    máquina que antes solo describía el mundo, ahora se atreve a proponer uno.
                </p>
                <p>
                    Por eso estas diez imágenes ya no son solo una galería, son casi un registro
                    fósil: la prueba de un momento breve donde la inteligencia artificial todavía
                    no sabía mentir bien, apenas empezaba a descubrir que también podía ser artista.
                    Vale la pena mirarlas así, sabiendo que esa torpeza visible no va a volver.
                </p>
            </div>
            </div>
        </section>

        <section id="contact" class="reveal-right content-section">
            <div class="section-inner contact-card">
                <h2>Contacto</h2>
                <p>Email: <a href="mailto:desvox23@gmail.com">desvox23@gmail.com</a></p>

                <div class="discord-block">
                    <h3>Únete al Discord</h3>
                    <p>¿Tienes preguntas, ideas o simplemente deseas conversar sobre temas de interés?</p>
                    <p>Te invito a unirte al servidor creado para este sitio:</p>
                    <a href="https://discord.gg/aCaHssJJu" target="_blank" class="vitra-btn vitra-btn-glass discord-invite">
                        <img width="28" loading="lazy" alt="" src="https://www.tradingdigits.io/assets/images/discordLogo.png">
                        <span>Discord</span>
                    </a>
                </div>
            </div>
        </section>

    </div>
</Layout>

<script>
  import "../scripts/homescript.js";
</script>

<style>
  .home-container {
    position: relative;
    overflow: hidden;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--vitra-space-8, 4rem);
    padding-block: var(--vitra-space-6, 3rem) var(--vitra-space-10, 5rem);
  }

  #home {
    position: relative;
    overflow: hidden;
    border-radius: 12px;
    min-height: 78vh;
    display: grid;
    place-items: center;
    --vitra-scenery-halo-x: 78%;
    --vitra-scenery-halo-y: 12%;
    --vitra-scenery-halo-size: clamp(90px, 12vw, 160px);
    /* Swap Vitra's default amber moonlight/sky-glow for a cool blue in
       line with the site's teal/blue palette (--cool-accent-h). Ridge
       silhouettes stay on --vitra-scenery-hue (teal), untouched. */
    --vitra-scenery-warm-h: var(--cool-accent-h);
  }

  /* Extra opaque halo behind the stars layer: Vitra's star mask hole
     tracks the moon's solid disc but not its box-shadow glow radius, so
     faint stars bleed through near the corona. This sits between stars
     (z-index:0) and the halo (z-index:1) and blocks that bleed without
     touching Vitra's own mask math. */
  #home::before {
    content: "";
    position: absolute;
    z-index: 1;
    left: var(--vitra-scenery-halo-x);
    top: var(--vitra-scenery-halo-y);
    width: calc(var(--vitra-scenery-halo-size) * 3.4);
    height: calc(var(--vitra-scenery-halo-size) * 3.4);
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: radial-gradient(
      circle,
      hsl(var(--vitra-scenery-hue) 40% 6% / 65%) 0%,
      hsl(var(--vitra-scenery-hue) 40% 6% / 30%) 45%,
      transparent 70%
    );
    pointer-events: none;
  }

  /* Vitra's ridge-near mask leaves a hard near-black band at the very
     bottom of the scenery container; fade it into the page background
     instead of letting it cut off sharply. */
  #home::after {
    content: "";
    position: absolute;
    z-index: 1;
    inset: auto 0 0 0;
    height: 28%;
    background: linear-gradient(to bottom, transparent, var(--vitra-color-bg) 85%);
    pointer-events: none;
  }

  .hero-inner {
    position: relative;
    z-index: 2;
    text-align: center;
    max-width: 760px;
    margin-inline: auto;
    padding: var(--vitra-space-6, 3rem) var(--vitra-space-4, 2rem);
  }

  .hero-kicker {
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--vitra-color-accent, #4c9df5);
    margin-bottom: 0.75rem;
  }

  .hero-inner h1 {
    font-size: clamp(2.75rem, 2rem + 3vw, 4.5rem);
    line-height: 1.05;
    margin-block: 0 1.25rem;
  }

  .hero-lead {
    font-size: clamp(1.1rem, 1rem + 0.4vw, 1.35rem);
    font-weight: 500;
    color: var(--vitra-color-text-primary, #fff);
    max-width: 600px;
    margin-inline: auto;
  }

  .hero-sub {
    font-size: 0.95rem;
    color: var(--vitra-color-text-secondary, #ffffffb3);
    max-width: 540px;
    margin-inline: auto;
    margin-top: 0.75rem;
  }

  .content-section {
    padding-block: var(--vitra-space-10, 5rem);
  }

  .section-inner {
    max-width: 720px;
    margin-inline: auto;
    text-align: center;
  }

  .gallery-inner {
    max-width: 1100px;
  }

  .projects-inner {
    max-width: 1100px;
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--vitra-space-4, 2rem);
    margin-top: var(--vitra-space-4, 2rem);
    text-align: left;
  }

  .project-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    gap: 0.75rem;
    padding: var(--vitra-space-4, 2rem);
    border-radius: 14px;
    text-decoration: none;
    color: inherit;
    transition: transform var(--transition-smooth, 0.3s), box-shadow var(--transition-smooth, 0.3s);
  }

  .project-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-1, 0 18px 32px rgba(5, 16, 33, 0.28));
  }

  .project-card-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .project-card-head h3 {
    margin: 0;
    font-size: 1.15rem;
  }

  .project-lang {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8rem;
    color: var(--text-muted, #cbd6e6);
    white-space: nowrap;
  }

  .project-lang-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--vitra-color-accent, #4c9df5);
  }

  .project-lang-dot[data-lang="python"] {
    background: #3572a5;
  }

  .project-desc {
    margin: 0;
    color: var(--text-muted, #cbd6e6);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .project-meta {
    display: flex;
    justify-content: flex-end;
    font-size: 0.8rem;
    color: var(--text-muted, #cbd6e6);
    margin-top: auto;
  }

  .project-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 0.25rem;
    padding: 0.6rem 1rem;
    border-radius: 10px;
    background: linear-gradient(135deg, var(--vitra-color-accent, #4c9df5), var(--vitra-color-accent-2, #64ffda));
    color: #05101f;
    font-size: 0.9rem;
    font-weight: 700;
    text-align: center;
  }

  .project-cta-arrow {
    transition: transform 0.2s ease;
  }

  .project-card:hover .project-cta-arrow {
    transform: translateX(4px);
  }

  .github-link,
  .discord-invite {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 1rem;
    padding: 0.75rem 1.5rem;
    text-decoration: none;
    font-weight: 600;
  }

  .discord-block {
    text-align: center;
    margin-top: 1.5rem;
  }

  .discord-block h3 {
    font-size: 1.4rem;
    border: 0;
  }

  .discord-invite {
    margin-top: 1rem;
  }
</style>
