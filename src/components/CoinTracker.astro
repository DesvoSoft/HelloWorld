---
// CoinTracker.astro
interface Props {
  coinId: string;
  name: string;
  symbol: string;
  color: string;
  featured?: boolean;
}

const { coinId, name, symbol, color, featured = false } = Astro.props;
const uid = coinId;
---

<div class="coin-tracker-container">
  <div class:list={["coin-tracker-card", "vitra-glass", { featured }]} data-coin={uid}>
    {featured && <span class="featured-badge">Indicador principal</span>}
    <div class="tracker-header">
      <div class="coin-info">
        <div class="coin-icon clickable" data-coingecko-link={`https://www.coingecko.com/en/coins/${coinId}`} style={`background:${color}22; color:${color};`} title={`Click to view ${name} on CoinGecko`}>
          <span class="coin-symbol-mark">{symbol[0]}</span>
        </div>
        <span class="coin-name clickable" data-coingecko-link={`https://www.coingecko.com/en/coins/${coinId}`} title={`Click to view ${name} on CoinGecko`}>{name}</span>
        <span class="coin-symbol clickable" data-coingecko-link={`https://www.coingecko.com/en/coins/${coinId}`} title={`Click to view ${name} on CoinGecko`}>{symbol}</span>
      </div>
    </div>

    <div class="price-container">
      <div class="current-price" data-price>Loading...</div>
      <div class="price-change" data-change>
        <span class="change-value">--</span>
      </div>
    </div>

    <div class="graph-container">
      <svg class="sparkline-svg" width="100%" height="80" viewBox="0 0 100 80" preserveAspectRatio="none">
        <path data-sparkline-path d="" fill="none" stroke={color} stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
        <path data-sparkline-area d="" fill={`url(#sparkline-gradient-${uid})`} opacity="0.15"></path>
        <defs>
          <linearGradient id={`sparkline-gradient-${uid}`} x1="0" y1="0" x2="0" y2="1">
            <stop data-grad-stop0 offset="0%" stop-color={color} />
            <stop data-grad-stop1 offset="100%" stop-color={color} stop-opacity="0" />
          </linearGradient>
        </defs>
      </svg>
    </div>

    <div class="momentum-gauge" data-gauge>
      <div class="gauge-header">
        <span class="gauge-label">Momentum 24h</span>
        <span class="gauge-status" data-gauge-status>--</span>
      </div>
      <div class="gauge-track">
        <div class="gauge-zone gauge-zone-cold"></div>
        <div class="gauge-zone gauge-zone-neutral"></div>
        <div class="gauge-zone gauge-zone-hot"></div>
        <div class="gauge-marker" data-gauge-marker></div>
      </div>
      <div class="gauge-scale">
        <span>Frío</span>
        <span>Neutral</span>
        <span>Caliente</span>
      </div>
    </div>

    <div class="tracker-footer">
      <span class="last-updated">Última actualización: <span data-update-time>--</span></span>
    </div>
  </div>
</div>

<style>
  .coin-tracker-container {
    display: flex;
    justify-content: center;
    width: 100%;
    margin: 1.25rem 0;
  }

  .coin-tracker-card {
    padding: 2rem;
    width: 100%;
    max-width: 380px;
    font-family: var(--font-main, 'Inter', system-ui, sans-serif);
    transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275), box-shadow 0.4s ease;
    position: relative;
    overflow: hidden;
  }

  .coin-tracker-card:hover {
    transform: translateY(-6px) scale(1.01);
  }

  .coin-tracker-card.featured {
    max-width: 440px;
    padding: 2.5rem;
    border: 1px solid var(--vitra-color-accent, #64ffda66);
    box-shadow: 0 0 0 1px var(--vitra-color-accent-soft, rgba(100, 255, 218, 0.15)),
      0 20px 60px -20px var(--vitra-color-accent-soft, rgba(100, 255, 218, 0.35));
  }

  .coin-tracker-card.featured:hover {
    transform: translateY(-8px) scale(1.015);
  }

  .coin-tracker-card.featured .current-price {
    font-size: 3rem;
  }

  .coin-tracker-card.featured .graph-container {
    height: 100px;
  }

  .coin-tracker-card.featured .sparkline-svg {
    height: 100px;
  }

  /* 12px es el suelo de tamaño de texto del sitio: por debajo, en un móvil a
     brazo extendido, deja de leerse. Antes 0.65rem = 10.4px. */
  .featured-badge {
    position: absolute;
    top: 1rem;
    right: 1rem;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--vitra-color-accent, #64ffda);
    background: var(--vitra-color-accent-soft, rgba(100, 255, 218, 0.12));
    border: 1px solid var(--vitra-color-accent, #64ffda);
    padding: 0.25rem 0.6rem;
    border-radius: 999px;
  }

  .tracker-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.25rem;
  }

  .coin-info {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .coin-icon {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 0.95rem;
  }

  .coin-name {
    font-weight: 700;
    color: var(--vitra-color-text-strong, #e6f0ff);
    font-size: 1.2rem;
    letter-spacing: -0.01em;
  }

  .coin-symbol {
    color: var(--vitra-color-text-muted, #94a3b8);
    font-size: 0.9rem;
    font-weight: 600;
    background: var(--vitra-color-accent-soft, rgba(100, 255, 218, 0.1));
    padding: 0.1rem 0.5rem;
    border-radius: 6px;
  }

  /* `all` obliga al navegador a vigilar cada propiedad animable del elemento;
     aquí solo cambian estas dos en :hover. */
  .clickable {
    cursor: pointer;
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .clickable:hover {
    opacity: 0.8;
    transform: scale(1.05);
  }

  .price-container {
    margin-bottom: 1.5rem;
    text-align: center;
  }

  .current-price {
    font-size: 2.5rem;
    font-weight: 800;
    color: var(--vitra-color-text-strong, #e6f0ff);
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .price-change {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 1rem;
    font-weight: 700;
    margin-top: 0.5rem;
    padding: 0.2rem 0.6rem;
    border-radius: 8px;
  }

  .price-change.up { color: #4ade80; background: rgba(74, 222, 128, 0.2); }
  .price-change.down { color: #f87171; background: rgba(248, 113, 113, 0.2); }

  /* El bloque de error lo construye el script con createElement, asi que no
     lleva el atributo de scope que Astro pone en el marcado del template: sin
     :global() ninguna de estas reglas llegaba a aplicarse y el fallo de red se
     veia como un boton del navegador sin estilar. El ancla .current-price si
     esta en el template, de modo que el escape sigue acotado a esta tarjeta. */
  .current-price.has-error {
    font-size: 1.1rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
  }

  .current-price :global(.price-error-msg) {
    display: block;
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--vitra-color-text-muted, #94a3b8);
  }

  .current-price :global(.price-retry-btn) {
    margin-top: 0.6rem;
    min-height: 44px;
    padding: 0.4rem 1rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--vitra-color-accent, #64ffda);
    background: var(--vitra-color-accent-soft, rgba(100, 255, 218, 0.1));
    border: 1px solid var(--vitra-color-accent, #64ffda);
    border-radius: 8px;
    cursor: pointer;
    transition: transform 0.2s, filter 0.2s;
  }

  .current-price :global(.price-retry-btn:hover) {
    transform: translateY(-1px);
    filter: brightness(1.1);
  }

  .graph-container {
    height: 80px;
    margin: 1.5rem -2rem;
    padding: 0 2rem;
    position: relative;
  }

  .momentum-gauge {
    margin-top: 0.5rem;
  }

  .gauge-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.5rem;
  }

  .gauge-label {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--vitra-color-text-muted, #94a3b8);
  }

  .gauge-status {
    font-size: 0.78rem;
    font-weight: 700;
  }

  .gauge-status.cold { color: #f87171; }
  .gauge-status.neutral { color: #facc15; }
  .gauge-status.hot { color: #4ade80; }

  .gauge-track {
    position: relative;
    display: flex;
    height: 8px;
    border-radius: 999px;
    overflow: visible;
  }

  .gauge-zone {
    flex: 1;
    height: 100%;
  }

  .gauge-zone-cold {
    background: #f87171;
    border-radius: 999px 0 0 999px;
    opacity: 0.55;
  }

  .gauge-zone-neutral {
    background: #facc15;
    opacity: 0.55;
  }

  .gauge-zone-hot {
    background: #4ade80;
    border-radius: 0 999px 999px 0;
    opacity: 0.55;
  }

  .gauge-marker {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--vitra-color-text-strong, #e6f0ff);
    border: 2px solid rgba(0, 0, 0, 0.4);
    box-shadow: 0 0 8px rgba(0, 0, 0, 0.5);
    transform: translate(-50%, -50%);
    transition: left 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .gauge-scale {
    display: flex;
    justify-content: space-between;
    margin-top: 0.4rem;
    /* 0.65rem daba 10.4px reales: por debajo del minimo legible en movil. */
    font-size: 0.75rem;
    color: var(--vitra-color-text-muted, #94a3b8);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .tracker-footer {
    border-top: 1px solid var(--vitra-color-border, rgba(100, 255, 218, 0.15));
    padding-top: 1rem;
    margin-top: 1.5rem;
    display: flex;
    justify-content: center;
  }

  .last-updated {
    font-size: 0.8rem;
    color: var(--vitra-color-text-muted, #94a3b8);
    font-weight: 500;
  }
</style>

<script>
  /* Un solo temporizador para todas las tarjetas, en vez de un setInterval por
     instancia. Ademas se detiene cuando la pestana esta oculta o cuando las
     tarjetas salen del viewport — la pagina de crypto mide ~26.300 px de alto,
     asi que lo normal es que esten fuera de pantalla. Antes seguia pidiendo
     precios a CoinGecko en segundo plano indefinidamente. */
  const REFRESH_MS = 60000;

  const trackers: { refresh: () => void; visible: boolean; el: HTMLElement }[] = [];
  let timer: number | undefined;
  let lastRun = Date.now();

  function anyActive() {
    return document.visibilityState === 'visible' && trackers.some((t) => t.visible);
  }

  function tick() {
    lastRun = Date.now();
    for (const t of trackers) {
      if (t.visible) t.refresh();
    }
  }

  function sync() {
    if (anyActive()) {
      if (timer === undefined) {
        // Al volver, refresca de inmediato si el dato ya vencio.
        if (Date.now() - lastRun >= REFRESH_MS) tick();
        timer = window.setInterval(tick, REFRESH_MS);
      }
    } else if (timer !== undefined) {
      clearInterval(timer);
      timer = undefined;
    }
  }

  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        const tracker = trackers.find((t) => t.el === entry.target);
        if (tracker) tracker.visible = entry.isIntersecting;
      }
      sync();
    },
    { rootMargin: '200px' }
  );

  function register(refresh: () => void, el: HTMLElement) {
    trackers.push({ refresh, visible: false, el });
    observer.observe(el);
  }

  document.addEventListener('visibilitychange', sync);

  document.querySelectorAll<HTMLElement>('.coin-tracker-card[data-coin]').forEach((card) => {
    const coinId = card.dataset.coin;
    if (!coinId) return;

    const priceEl = card.querySelector<HTMLElement>('[data-price]');
    const changeEl = card.querySelector<HTMLElement>('[data-change]');
    const timeEl = card.querySelector<HTMLElement>('[data-update-time]');
    const sparklinePath = card.querySelector<SVGPathElement>('[data-sparkline-path]');
    const sparklineArea = card.querySelector<SVGPathElement>('[data-sparkline-area]');
    const stop0 = card.querySelector<SVGStopElement>('[data-grad-stop0]');
    const stop1 = card.querySelector<SVGStopElement>('[data-grad-stop1]');
    const gaugeMarker = card.querySelector<HTMLElement>('[data-gauge-marker]');
    const gaugeStatus = card.querySelector<HTMLElement>('[data-gauge-status]');

    card.querySelectorAll<HTMLElement>('[data-coingecko-link]').forEach((el) => {
      el.addEventListener('click', () => {
        const url = el.dataset.coingeckoLink;
        if (url) window.open(url, '_blank');
      });
    });

    async function fetchCoinPrice() {
      try {
        const response = await fetch(`https://api.coingecko.com/api/v3/coins/${coinId}?localization=false&tickers=false&market_data=true&community_data=false&developer_data=false&sparkline=true`);
        const data = await response.json();

        const price = data.market_data.current_price.usd;
        const change = data.market_data.price_change_percentage_24h;
        const sparklineData = data.market_data.sparkline_7d.price;

        if (priceEl) {
          priceEl.classList.remove('has-error');
          priceEl.textContent = new Intl.NumberFormat('en-US', {
            style: 'currency',
            currency: 'USD',
            minimumFractionDigits: price < 1 ? 4 : 0,
            maximumFractionDigits: price < 1 ? 4 : 0
          }).format(price);
        }

        if (changeEl) {
          const isUp = change >= 0;
          changeEl.className = `price-change ${isUp ? 'up' : 'down'}`;
          changeEl.innerHTML = `
            <span class="change-icon">${isUp ? '▲' : '▼'}</span>
            <span class="change-value">${Math.abs(change).toFixed(2)}%</span>
            <span class="change-period">(24h)</span>
          `;

          const color = isUp ? '#4ade80' : '#f87171';
          if (sparklinePath) sparklinePath.setAttribute('stroke', color);
          if (stop0) stop0.setAttribute('stop-color', color);
          if (stop1) stop1.setAttribute('stop-color', color);

          if (gaugeMarker) {
            const GAUGE_RANGE = 8;
            const clamped = Math.max(-GAUGE_RANGE, Math.min(GAUGE_RANGE, change));
            const position = ((clamped + GAUGE_RANGE) / (GAUGE_RANGE * 2)) * 100;
            gaugeMarker.style.left = `${position}%`;
          }

          if (gaugeStatus) {
            let statusClass = 'neutral';
            let statusText = 'Neutral';
            if (change <= -2) { statusClass = 'cold'; statusText = 'Frío'; }
            else if (change >= 2) { statusClass = 'hot'; statusText = 'Caliente'; }
            gaugeStatus.className = `gauge-status ${statusClass}`;
            gaugeStatus.textContent = statusText;
          }
        }

        if (sparklinePath && sparklineData && sparklineData.length > 0) {
          const min = Math.min(...sparklineData);
          const max = Math.max(...sparklineData);
          const range = max - min || 1;
          const width = 100;
          const height = 80;

          const points = sparklineData.map((p: number, i: number) => {
            const x = (i / (sparklineData.length - 1)) * width;
            const y = height - ((p - min) / range) * height;
            return `${x},${y}`;
          });

          const d = `M ${points.join(' L ')}`;
          sparklinePath.setAttribute('d', d);

          if (sparklineArea) {
            const areaD = `${d} L ${width},${height} L 0,${height} Z`;
            sparklineArea.setAttribute('d', areaD);
          }
        }

        if (timeEl) {
          timeEl.textContent = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
        }
      } catch (error) {
        console.error(`Error fetching ${coinId} price:`, error);
        if (priceEl) {
          priceEl.innerHTML = '';
          priceEl.classList.add('has-error');
          const msg = document.createElement('span');
          msg.className = 'price-error-msg';
          msg.textContent = 'No se pudo cargar el precio';
          const retryBtn = document.createElement('button');
          retryBtn.type = 'button';
          retryBtn.className = 'price-retry-btn';
          retryBtn.textContent = 'Reintentar';
          retryBtn.addEventListener('click', () => {
            priceEl.classList.remove('has-error');
            priceEl.textContent = 'Loading...';
            fetchCoinPrice();
          });
          priceEl.append(msg, retryBtn);
        }
      }
    }

    fetchCoinPrice();
    register(fetchCoinPrice, card);
  });
</script>
