---
const navLinks = [
    { href: "/HelloWorld/python/", label: "Python" },
    { href: "/HelloWorld/cpp/", label: "C++" },
    { href: "/HelloWorld/java/", label: "Java" },
    { href: "/HelloWorld/git/", label: "Git" },
    { href: "/HelloWorld/raptor/", label: "Raptor" },
    { href: "/HelloWorld/crypto/", label: "Crypto" },
    { href: "/HelloWorld/#contact", label: "Contacto" },
];

const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
    href.startsWith("#") ? false : currentPath.replace(/\/?$/, "/") === href;
---
<div class="vitra-navbar vitra-navbar-glass">
    <a href="/HelloWorld/" class="vitra-navbar-brand">
        <span class="code-line-logo"></span>Hello World
    </a>

    <div class="nav-right-group">
        <nav class="vitra-navbar-links">
            {navLinks.map((link) => (
                <a href={link.href} class="vitra-navbar-link" class:list={{ "is-active": isActive(link.href) }}>{link.label}</a>
            ))}
        </nav>

        <div class="vitra-navbar-actions">
            <button class="vitra-burger" aria-label="Abrir menú" aria-expanded="false">
                <span class="vitra-burger-line"></span>
                <span class="vitra-burger-line"></span>
                <span class="vitra-burger-line"></span>
            </button>
        </div>
    </div>
</div>

<div class="vitra-drawer-overlay"></div>
<div class="vitra-drawer vitra-drawer-glass">
    <div class="vitra-drawer-header">
        <span class="vitra-drawer-title">Hello World</span>
        <button class="vitra-drawer-close" aria-label="Cerrar menú">✕</button>
    </div>
    <div class="vitra-drawer-body">
        {navLinks.map((link) => (
            <a href={link.href} class="vitra-drawer-link" class:list={{ "is-active": isActive(link.href) }}>{link.label}</a>
        ))}
    </div>
</div>

<style>
    .nav-right-group {
        display: flex;
        align-items: center;
        gap: var(--vitra-space-4, 1.5rem);
    }
</style>

<script>
  const burger = document.querySelector(".vitra-burger");
  const drawer = document.querySelector(".vitra-drawer");
  const overlay = document.querySelector(".vitra-drawer-overlay");
  const drawerClose = document.querySelector(".vitra-drawer-close");

  function closeDrawer() {
    burger?.classList.remove("active");
    burger?.setAttribute("aria-expanded", "false");
    drawer?.classList.remove("open");
    overlay?.classList.remove("open");
  }

  function toggleDrawer() {
    const isOpen = drawer?.classList.toggle("open");
    overlay?.classList.toggle("open", !!isOpen);
    burger?.classList.toggle("active", !!isOpen);
    burger?.setAttribute("aria-expanded", String(!!isOpen));
  }

  const navbarEl = document.querySelector(".vitra-navbar");
  const syncNavbarHeight = () => {
    if (!navbarEl) return;
    document.documentElement.style.setProperty("--navbar-h", `${navbarEl.getBoundingClientRect().height}px`);
  };
  syncNavbarHeight();
  window.addEventListener("resize", syncNavbarHeight);
  if ("ResizeObserver" in window && navbarEl) {
    new ResizeObserver(syncNavbarHeight).observe(navbarEl);
  }

  if (burger && drawer && overlay) {
    burger.addEventListener("click", (e) => {
      e.stopPropagation();
      toggleDrawer();
    });

    overlay.addEventListener("click", closeDrawer);
    drawerClose?.addEventListener("click", closeDrawer);

    drawer.querySelectorAll(".vitra-drawer-link").forEach((link) => {
      link.addEventListener("click", closeDrawer);
    });
  }
</script>
